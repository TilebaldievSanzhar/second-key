# Скопируйте в .env и замените значения. .env не коммитится.
# Сгенерировать секрет: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Postgres ---
POSTGRES_USER=secondkey
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=secondkey

# --- S3 (локально RustFS; в проде — любой S3, тогда задайте SK_S3_ENDPOINT_URL) ---
S3_ACCESS_KEY=secondkey
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=secondkey

# --- Приложение (все настройки бэкенда — с префиксом SK_, см. backend/src/secondkey/config.py) ---
SK_JWT_SECRET=change-me-jwt-secret-at-least-32-chars
SK_LOG_LEVEL=INFO
SK_MAX_UPLOAD_MB=25
# прод: SK_COOKIE_SECURE=true и список доменов фронта
# SK_CORS_ORIGINS=["https://app.example.kg"]

# --- ИИ (необязательно): любой OpenAI-совместимый провайдер; без ключа ИИ-функции выключены ---
# SK_LLM_API_KEY=
# SK_LLM_BASE_URL=https://openrouter.ai/api/v1
# SK_LLM_MODEL=google/gemini-3.1-flash-lite-preview

# --- Интеграции с 1С ---
# Ключ шифрования паролей OData-подключений: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SK_DATA_KEY=
SK_PUBLIC_URL=http://localhost:5173
