// «Второй ключ: выгрузка закупок» — модуль внешней обработки 1С:Предприятие 8.3.
//
// Что делает: выбирает проведённые документы поступления за период и отправляет строки
// во «Второй ключ» по HTTPS с токеном интеграции. Публиковать базу на веб-сервере не нужно:
// соединение исходящее, из 1С в сервис.
//
// Вместе со строками уходят входящие номер и дата документа поставщика и реквизиты контрагентов
// (телефон, адрес, e-mail, основной счёт) — по ним «Второй ключ» видит связки снабженца и поставщика.
// С флажком «Сверять с сотрудниками» уходят и сотрудники — только хэшем ИНН (SHA-256 от «соль:ИНН»,
// соль выдаёт сервис): сами ИНН сотрудников из базы не уходят.
//
// Поддерживаемые конфигурации (определяются по метаданным):
//   БП 3.0 (в т.ч. редакции для КР и КЗ) — Документ.ПоступлениеТоваровУслуг
//   УТ 11, ERP, КА 2                       — Документ.ПриобретениеТоваровУслуг
// Для других конфигураций поправьте текст запроса в ТекстЗапроса().
//
// Как собрать обработку:
//   1. Конфигуратор → Файл → Новый → Внешняя обработка, имя «ВторойКлючВыгрузка».
//   2. Реквизиты обработки: НачалоПериода (Дата), КонецПериода (Дата), АдресСервиса (Строка 300),
//      Токен (Строка 100), СверятьССотрудниками (Булево). Создайте основную форму, выведите реквизиты,
//      добавьте команды «Выгрузить» и «ПроверитьСвязь».
//   3. Раздел МОДУЛЬ ОБЪЕКТА ниже вставьте в модуль объекта, раздел МОДУЛЬ ФОРМЫ — в модуль формы.
//   Или соберите обработку из XML-исходников агентом с навыками cc-1c-skills (epf-init, epf-build).
//
// Адрес сервиса — например https://second-key.example.kg/api; токен — Настройки → Подключение 1С
// во «Втором ключе» (права «Выгрузка из 1С»).

// ===================================== МОДУЛЬ ОБЪЕКТА =====================================

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Отправляет строки закупок за период. Возвращает текст результата для пользователя.
Функция Выгрузить(Начало, Конец, АдресСервиса, Токен, СверятьССотрудниками = Ложь) Экспорт

	Контрагенты = Новый Массив;
	Строки = СтрокиЗакупок(НачалоДня(Начало), КонецДня(Конец), Контрагенты);
	Если Строки.Количество() = 0 Тогда
		Возврат "За период нет проведённых документов поступления.";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("source", "1c:" + ИмяПрофиля());
	Тело.Вставить("period_start", Формат(Начало, "ДФ=yyyy-MM-dd"));
	Тело.Вставить("period_end", Формат(Конец, "ДФ=yyyy-MM-dd"));
	Тело.Вставить("lines", Строки);
	Тело.Вставить("suppliers", КарточкиПоставщиков(Контрагенты));
	Если СверятьССотрудниками Тогда
		Тело.Вставить("staff", Сотрудники(СольИНН(АдресСервиса, Токен)));
	КонецЕсли;

	Ответ = ОтправитьJSON(АдресСервиса, "/integrations/purchases", Токен, ВJSON(Тело));
	Если Ответ.КодСостояния = 202 Тогда
		Возврат СтрШаблон("Отправлено строк: %1. Проверка идёт во «Втором ключе», результат появится там через минуту.",
			Строки.Количество());
	КонецЕсли;
	Возврат СтрШаблон("Сервис ответил %1: %2", Ответ.КодСостояния, Лев(Ответ.ПолучитьТелоКакСтроку(), 500));

КонецФункции

// Проверка адреса и токена без отправки данных.
Функция ПроверитьСвязь(АдресСервиса, Токен) Экспорт

	Ответ = ВыполнитьЗапрос(АдресСервиса, "/integrations/ping", Токен, "GET", "");
	Если Ответ.КодСостояния = 200 Тогда
		Возврат "Связь есть, токен действителен.";
	КонецЕсли;
	Возврат СтрШаблон("Сервис ответил %1: %2", Ответ.КодСостояния, Лев(Ответ.ПолучитьТелоКакСтроку(), 300));

КонецФункции

Функция ИмяПрофиля()

	Если Метаданные.Документы.Найти("ПоступлениеТоваровУслуг") <> Неопределено Тогда
		Возврат "bp30";
	ИначеЕсли Метаданные.Документы.Найти("ПриобретениеТоваровУслуг") <> Неопределено Тогда
		Возврат "ut11";
	КонецЕсли;
	ВызватьИсключение "В конфигурации нет документа поступления товаров — поправьте ТекстЗапроса() под свою конфигурацию";

КонецФункции

Функция ТекстЗапроса()

	Если ИмяПрофиля() = "bp30" Тогда
		Возврат
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка,
		|	Док.Дата КАК Дата,
		|	Док.Номер КАК Номер,
		|	Док.Контрагент КАК Контрагент,
		|	Док.Контрагент.Наименование КАК Поставщик,
		|	Док.Контрагент.ИНН КАК ИНН,
		|	Док.НомерВходящегоДокумента КАК ВхНомер,
		|	Док.ДатаВходящегоДокумента КАК ВхДата,
		|	Док.Склад.Наименование КАК Объект,
		|	Док.Ответственный.Наименование КАК Ответственный,
		|	Док.СуммаВключаетНДС КАК СуммаВключаетНДС,
		|	Товары.Номенклатура.Наименование КАК Номенклатура,
		|	Товары.Номенклатура.ЕдиницаИзмерения.Наименование КАК Единица,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма,
		|	Товары.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Док
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
		|		ПО Товары.Ссылка = Док.Ссылка
		|ГДЕ
		|	Док.Проведен
		|	И Док.Дата МЕЖДУ &Начало И &Конец
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата,
		|	Товары.НомерСтроки";
	КонецЕсли;

	// УТ 11, ERP, КА 2: сумма строки с НДС — СуммаСНДС, ответственный — менеджер
	Возврат
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Дата КАК Дата,
	|	Док.Номер КАК Номер,
	|	Док.Контрагент КАК Контрагент,
	|	Док.Контрагент.Наименование КАК Поставщик,
	|	Док.Контрагент.ИНН КАК ИНН,
	|	Док.НомерВходящегоДокумента КАК ВхНомер,
	|	Док.ДатаВходящегоДокумента КАК ВхДата,
	|	Док.Склад.Наименование КАК Объект,
	|	Док.Менеджер.Наименование КАК Ответственный,
	|	ИСТИНА КАК СуммаВключаетНДС,
	|	Товары.Номенклатура.Наименование КАК Номенклатура,
	|	Товары.Номенклатура.ЕдиницаИзмерения.Наименование КАК Единица,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.СуммаСНДС КАК Сумма,
	|	Товары.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
	|		ПО Товары.Ссылка = Док.Ссылка
	|ГДЕ
	|	Док.Проведен
	|	И Док.Дата МЕЖДУ &Начало И &Конец
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Товары.НомерСтроки";

КонецФункции

// Строки в формате контракта «Второго ключа» (backend/src/secondkey/integrations/contract.py).
// Контрагенты — массив, который заполняется ссылками на поставщиков из строк.
Функция СтрокиЗакупок(Начало, Конец, Контрагенты)

	Запрос = Новый Запрос(ТекстЗапроса());
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();

	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Сумма = Выборка.Сумма;
		Если Не Выборка.СуммаВключаетНДС Тогда
			Сумма = Сумма + Выборка.СуммаНДС; // в БП «Сумма» без НДС, если цена его не включает
		КонецЕсли;
		Запись = Новый Структура;
		Запись.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-dd"));
		Запись.Вставить("doc", СтрШаблон("%1 %2 от %3", Выборка.Ссылка.Метаданные().Синоним,
			СокрЛП(Выборка.Номер), Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")));
		Запись.Вставить("supplier", СокрЛП(Выборка.Поставщик));
		Запись.Вставить("supplier_inn", СокрЛП(Выборка.ИНН));
		Запись.Вставить("item", СокрЛП(Выборка.Номенклатура));
		Запись.Вставить("unit", СокрЛП(Выборка.Единица));
		Запись.Вставить("qty", Выборка.Количество);
		Запись.Вставить("price", Выборка.Цена);
		Запись.Вставить("amount", Сумма);
		Запись.Вставить("vat", Выборка.СуммаНДС);
		Запись.Вставить("object", СокрЛП(Выборка.Объект));
		Запись.Вставить("responsible", СокрЛП(Выборка.Ответственный));
		Запись.Вставить("ref", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Если ЗначениеЗаполнено(Выборка.ВхНомер) Тогда
			Запись.Вставить("doc_in_no", Лев(СокрЛП(Выборка.ВхНомер), 64));
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ВхДата) Тогда
			Запись.Вставить("doc_in_date", Формат(Выборка.ВхДата, "ДФ=yyyy-MM-dd"));
		КонецЕсли;
		Результат.Добавить(Запись);
		Если Контрагенты.Найти(Выборка.Контрагент) = Неопределено Тогда
			Контрагенты.Добавить(Выборка.Контрагент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Реквизиты поставщиков: ИНН, телефон, адрес, e-mail из контактной информации и основной счёт.
// Если в конфигурации нет основного счёта у контрагента (УТ 11, ERP) — уходят без него.
Функция КарточкиПоставщиков(Контрагенты)

	Карточки = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка,
	|	К.Наименование КАК Наименование,
	|	К.ИНН КАК ИНН,
	|	К.ОсновнойБанковскийСчет.НомерСчета КАК Счет
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	К.Ссылка В (&Контрагенты)";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "К.ОсновнойБанковскийСчет.НомерСчета", """""");
		Выборка = Запрос.Выполнить().Выбрать();
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Карточка = Новый Структура("name, inn", СокрЛП(Выборка.Наименование), СокрЛП(Выборка.ИНН));
		Если ЗначениеЗаполнено(Выборка.Счет) Тогда
			Карточка.Вставить("bank_account", Лев(СокрЛП(Выборка.Счет), 64));
		КонецЕсли;
		Карточки.Вставить(Выборка.Ссылка, Карточка);
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	КИ.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон) ТОГДА ""phone""
	|		КОГДА КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты) ТОГДА ""email""
	|		КОГДА КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес) ТОГДА ""address""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Поле,
	|	КИ.Представление КАК Представление
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Ссылка В (&Контрагенты)";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Карточка = Карточки.Получить(Выборка.Ссылка);
			Если Карточка = Неопределено Или Выборка.Поле = "" Или Карточка.Свойство(Выборка.Поле) Тогда
				Продолжить;
			КонецЕсли;
			Карточка.Вставить(Выборка.Поле, Лев(СокрЛП(Выборка.Представление), 200));
		КонецЦикла;
	Исключение
		// контактной информации в таком виде нет — карточки уходят с ИНН и счётом
	КонецПопытки;

	Результат = Новый Массив;
	Для Каждого Элемент Из Карточки Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сотрудники и пользователи с ИНН — только хэшем. Имя — как в документах (поле «Ответственный»).
Функция Сотрудники(Соль)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	С.Наименование КАК Имя,
	|	С.ФизическоеЛицо.ИНН КАК ИНН
	|ИЗ
	|	Справочник.Сотрудники КАК С
	|ГДЕ
	|	НЕ С.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	П.Наименование,
	|	П.ФизическоеЛицо.ИНН
	|ИЗ
	|	Справочник.Пользователи КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления");
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИНН = СокрЛП(Выборка.ИНН);
		Если ИНН = "" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("name, inn_hash", СокрЛП(Выборка.Имя), ХэшИНН(Соль, ИНН)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// SHA-256 от «соль:ИНН», hex в нижнем регистре — так же считает сервис (engine/inn.py, inn_hash).
Функция ХэшИНН(Соль, ИНН)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Соль + ":" + ИНН);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Соль организации для хэшей ИНН — из ответа /integrations/ping.
Функция СольИНН(АдресСервиса, Токен)

	Ответ = ВыполнитьЗапрос(АдресСервиса, "/integrations/ping", Токен, "GET", "");
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("Не удалось получить соль для сверки с сотрудниками: сервис ответил %1",
			Ответ.КодСостояния);
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные.inn_salt;

КонецФункции

Функция ВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ОтправитьJSON(АдресСервиса, Путь, Токен, Текст)

	Возврат ВыполнитьЗапрос(АдресСервиса, Путь, Токен, "POST", Текст);

КонецФункции

Функция ВыполнитьЗапрос(АдресСервиса, Путь, Токен, Метод, Текст)

	Адрес = РазобратьАдрес(АдресСервиса);
	Защита = ?(Адрес.Схема = "https", Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 120, Защита);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + СокрЛП(Токен));
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос = Новый HTTPЗапрос(Адрес.Путь + Путь, Заголовки);

	Если Метод = "POST" Тогда
		Запрос.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Соединение.ОтправитьДляОбработки(Запрос);
	КонецЕсли;
	Возврат Соединение.Получить(Запрос);

КонецФункции

// «https://host:8443/api» → Схема, Хост, Порт, Путь
Функция РазобратьАдрес(АдресСервиса)

	Адрес = СокрЛП(АдресСервиса);
	Если СтрЗаканчиваетсяНа(Адрес, "/") Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;
	Результат = Новый Структура("Схема, Хост, Порт, Путь", "https", "", 443, "");
	Позиция = СтрНайти(Адрес, "://");
	Если Позиция > 0 Тогда
		Результат.Схема = НРег(Лев(Адрес, Позиция - 1));
		Адрес = Сред(Адрес, Позиция + 3);
	КонецЕсли;
	Результат.Порт = ?(Результат.Схема = "https", 443, 80);
	Позиция = СтрНайти(Адрес, "/");
	Если Позиция > 0 Тогда
		Результат.Путь = Сред(Адрес, Позиция);
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;
	Позиция = СтрНайти(Адрес, ":");
	Если Позиция > 0 Тогда
		Результат.Порт = Число(Сред(Адрес, Позиция + 1));
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;
	Результат.Хост = Адрес;
	Возврат Результат;

КонецФункции

#КонецЕсли

// ===================================== МОДУЛЬ ФОРМЫ =====================================

&НаКлиенте
Процедура Выгрузить(Команда)

	Если Не ЗначениеЗаполнено(Объект.АдресСервиса) Или Не ЗначениеЗаполнено(Объект.Токен) Тогда
		ПоказатьПредупреждение(, "Укажите адрес сервиса и токен из настроек «Второго ключа».");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ВыгрузитьНаСервере());

КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.Выгрузить(Объект.НачалоПериода, Объект.КонецПериода, Объект.АдресСервиса, Объект.Токен,
		Объект.СверятьССотрудниками);

КонецФункции

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	ПоказатьПредупреждение(, ПроверитьСвязьНаСервере());

КонецПроцедуры

&НаСервере
Функция ПроверитьСвязьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПроверитьСвязь(Объект.АдресСервиса, Объект.Токен);

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.КонецПериода) Тогда
		Объект.КонецПериода = ТекущаяДатаСеанса();
		Объект.НачалоПериода = ДобавитьМесяц(НачалоМесяца(Объект.КонецПериода), -11);
	КонецЕсли;

КонецПроцедуры
